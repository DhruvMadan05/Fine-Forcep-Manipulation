# Copy this file to .env and set AMBF_WS to the absolute path of your built
# ros_ambf_ws (the ROS 2 workspace containing src/ambf, built with colcon).
AMBF_WS=/home/you/ros_ambf_ws

# ROS 2 distro to source before the AMBF workspace. Change if your machine
# uses a different distro.
ROS_DISTRO=jazzy
